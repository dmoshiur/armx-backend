#
# A.R.M.X AI backend - complete environment reference.
# Copy to `.env` for local work:  cp .env.example .env
# Every value here is a placeholder. Never commit a real secret.
#
# Two profiles are supported:
#   * development / demo  -> SQLite file + outbox email + in-process jobs + mock LLM
#   * production          -> Supabase/PostgreSQL + real secrets + real transports
# The app refuses to start when ENVIRONMENT=production and a required secret is
# missing or left as a placeholder (see app/config.py).

# ---------------------------------------------------------------- core runtime
ENVIRONMENT=development                 # development | demo | staging | production
APP_NAME=A.R.M.X AI
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console                      # console (human) | json (shipped to a log drain)
DEMO_INSECURE=true                      # allows plain HTTP. Forbidden in production.
API_HOST=0.0.0.0
API_PORT=8000
WEB_CONCURRENCY=2                       # uvicorn worker processes behind nginx
BACKEND_CORS_ORIGINS=                   # comma-separated browser origins, e.g. https://app.example.com
ALLOW_PLAIN_HTTP_HEALTH_PROBE=false     # liveness probes only; never on a public host
TRUSTED_PROXY_IPS=                      # e.g. 172.16.0.0/12 when behind nginx/compose

# --------------------------------------------------------------- database (DB)
# Local dev uses SQLite. Production uses Supabase PostgreSQL, e.g.
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase's transaction pooler (port 6543) is required for serverless/short-lived
# workers; use :5432 for a direct connection. The driver is upgraded to the async
# psycopg3 dialect automatically when a plain postgresql:// URL is supplied.
DATABASE_URL=sqlite+aiosqlite:///./data/armx.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_ECHO=false
DB_AUTO_MIGRATE=true                    # run `alembic upgrade head` on container start

# ---------------------------------------------------------------- Supabase (opt)
# Only used for object storage (generated sites / edited images) and as a
# convenience when assembling DATABASE_URL. Secrets live here, never in code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=armx-assets

# ------------------------------------------------------------------------- auth
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ISSUER=armx-ai
JWT_AUDIENCE=armx-clients
ACCESS_TOKEN_TTL_SECONDS=900            # <= 15 minutes, hard ceiling enforced
REFRESH_TOKEN_TTL_SECONDS=2592000       # 30 days, rotated on every use
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=12
# Fernet key for encrypted-secret-at-rest (integration secret refs, memory items).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ------------------------------------------------------------- email + SMTP out
# EMAIL_DELIVERY_MODE=outbox keeps every message in the mail_outbox table (read it
# with GET /admin/mail) so signup / password reset are fully testable without SMTP.
# Switch to `smtp` only after the phase-3 acceptance checks pass.
EMAIL_DELIVERY_MODE=outbox              # outbox | smtp
MAIL_FROM_ADDRESS=no-reply@thamjj13.top
MAIL_FROM_NAME=A.R.M.X AI
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
EMAIL_TOKEN_TTL_SECONDS=1800            # email verification + password reset (15-30 min)

# ----------------------------------------------------------------- Google OAuth
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_OAUTH_ALLOWED_DOMAINS=           # comma separated; empty = any verified Google account

# -------------------------------------------------------------- LLM (planner)
# The LLM is an untrusted planner: it proposes tool calls, the Security Gateway
# decides. `mock` is deterministic and needs no credentials (used by the test
# suite and by `LLM_PROVIDER=mock` demos).
LLM_PROVIDER=mock                       # mock | openai | anthropic | ollama | openai_compatible
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --------------------------------------------------------------- harness bounds
HARNESS_MAX_TOOL_CALLS=8                # per session (hard cap)
HARNESS_MAX_MODEL_TURNS=6
HARNESS_DEADLINE_SECONDS=120
HARNESS_TOOL_TIMEOUT_SECONDS=30
HARNESS_MAX_RESULT_CHARS=8000           # tool output truncation before it reaches the model
HARNESS_MAX_HISTORY_MESSAGES=40

# ------------------------------------------------------------- security gateway
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute           # global per-actor default
RATE_LIMIT_AUTH=10/minute               # login/signup/forgot-password per IP
RATE_LIMIT_TOOL_DEFAULT=60/hour
APPROVAL_TTL_SECONDS=300                # fresh, exact-action approvals expire quickly
APPROVAL_MAX_PENDING_PER_USER=20
KILL_SWITCH_ALLOWED_TOOLS=health_status # tools that still answer while the kill-switch is engaged

# ------------------------------------------------------------- linked devices
PAIRING_CODE_TTL_SECONDS=600
LINKED_DEVICE_OWNER_PASSWORD_MIN_LENGTH=12
DEVICE_KEY_TTL_SECONDS=31536000
PC_UNLOCK_TOKEN_TTL_SECONDS=30          # device-held signed unlock tokens are shorter still

# --------------------------------------------------------- smart home (HA/MQTT)
HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_BASE_URL=http://home-assistant:8123
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ENTITY_ALLOWLIST=light.living_room,switch.fan
MQTT_ENABLED=false
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_CA_FILE=/run/armx/mqtt-ca/ca.crt
MQTT_CLIENT_ID=armx-api
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_SITE=home
MQTT_COMMAND_TIMEOUT_SECONDS=10
MQTT_KEEPALIVE_SECONDS=30

# ------------------------------------------------------- web builder (GH/Vercel)
WEB_BUILDER_ENABLED=false
GITHUB_ENABLED=false
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_REPO_ALLOWLIST=                  # exactly one owner/repo per deployment, e.g. dmoshiur/armx-sites
GITHUB_DEPLOY_BRANCH=main
VERCEL_ENABLED=false
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_API_BASE=https://api.vercel.com
VERCEL_PROJECT_ALLOWLIST=               # e.g. armx-sites
SITE_SANDBOX_DIR=./var/sites
SITE_MAX_FILES=64
SITE_MAX_BYTES=1048576
SITE_PREVIEW_BASE_URL=http://localhost:8000/preview

# ------------------------------------------------------------------- n8n bridge
N8N_ENABLED=false
N8N_BASE_URL=http://n8n:5678
N8N_SIGNING_SECRET=
N8N_TIMEOUT_SECONDS=30
# Per-workflow allowlist. Risk and confirm are declared per workflow; a workflow
# that sends/posts/uploads/deletes must be marked high+confirm=true.
# Format: name|/webhook/path|risk|confirm  (comma separated)
N8N_WORKFLOWS=

# ------------------------------------------------------------- MCP (allowlist)
MCP_ENABLED=false
# Explicit allowlist only: name|transport|url|allowed_tools(;-separated)|timeout
MCP_SERVERS=
MCP_MAX_RESULT_BYTES=32768
MCP_TIMEOUT_SECONDS=20

# ------------------------------------------------------------ web search (data)
SEARCH_ENABLED=false
SEARCH_PROVIDER=none                    # none | google | bing
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
BING_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10

# --------------------------------------------------------------- mail (readonly)
MAIL_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_MAX_MESSAGES=20

# --------------------------------------------------------------- messaging APIs
MESSAGING_ENABLED=false
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
MESSENGER_ENABLED=false
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSAGING_DEFAULT_AUTO_SEND=false       # per-contact override lives in messaging_profiles

# ------------------------------------------------------------------ image edits
IMAGE_PROVIDER=mock                     # mock | openai | stability
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=4096000
IMAGE_ALLOWED_FORMATS=png,jpeg,webp
IMAGE_TIMEOUT_SECONDS=60
IMAGE_STORAGE_DIR=./var/images
IMAGE_ASSET_TTL_SECONDS=86400

# --------------------------------------------------------- jobs (worker process)
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=1.0
JOB_TIMEOUT_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETENTION_DAYS=14

# ------------------------------------------------------- audit + memory hygiene
AUDIT_RETENTION_DAYS=365
MEMORY_RETENTION_DAYS=180
MEMORY_MAX_ITEMS_PER_USER=500

# ------------------------------------------------------------------- operations
BACKUP_DIR=./var/backups
BACKUP_AGE_SECONDS=0                    # seconds of pg_dump age an alert tolerates
METRICS_ENABLED=true
ALERT_WEBHOOK_URL=                      # optional: POSTs a JSON alert on critical failures
SECRET_ROTATION_DUE_DAYS=90
