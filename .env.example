# Explicit local/demo HTTP-only profile. Never enable outside a local/demo network.
ENVIRONMENT=demo
DEMO_INSECURE=true
BACKEND_PORT=8000

# Local runs and tests use the libSQL dialect against a file - the same code path used for
# Turso. For a hosted deployment set a remote URL and keep the token out of the URL:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create`>
# Absolute local paths need four slashes: sqlite+libsql:////absolute/path.db
# DATABASE_URL=sqlite+libsql:///./armx.db
# DATABASE_TIMEOUT_SECONDS=30
# DATABASE_POOL_PRE_PING=true

# Generate a persistent random value and set it before pairing devices.
# JWT_SECRET_KEY=
# BOOTSTRAP_ADMIN_USERNAME=mohiur
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=owner@thamjj13.top
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Md. Moshiur Rahman Mohi

# Browser origins for Flutter web/desktop builds only; native clients ignore CORS.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# Render's internal liveness probe is plain HTTP (the platform edge still redirects public
# HTTP to HTTPS). Enabling this excepts only a parameterless GET /health from the TLS rule;
# never enable it on a host that is reachable directly from an untrusted network.
# ALLOW_PLAIN_HTTP_HEALTH_PROBE=false

# Compose uses its private TLS broker and enables MQTT by default. For a direct local
# run without a broker, set MQTT_ENABLED=false. Never use anonymous broker access in prod.
# In production these point at the external broker (e.g. HiveMQ Cloud, TLS 8883) that the
# ESP32 devices also connect to; `MQTT_TLS_CA_FILE` stays unset for managed brokers so the
# system CA store is used.
# MQTT_ENABLED=false
# MQTT_HOST=localhost
# MQTT_PORT=8883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_KEEPALIVE_SECONDS=30
# MQTT_TLS_CA_FILE=

# LLM provider. The default is Ashna AI's hosted `ashna-x1` model, called through its
# OpenAI-compatible API (docs: https://www.ashna.ai/api-docs). Create a key at
# https://app.ashna.ai/account?tab=api and set ASHNA_API_KEY. Startup fails with a clear
# error when LLM_PROVIDER=ashna but no key is configured - it never silently falls back.
LLM_PROVIDER=ashna
# ASHNA_API_KEY=
# ASHNA_BASE_URL=https://api.ashna.ai/v1/api
# ASHNA_MODEL=ashna-x1
#
# Contributors without an Ashna key can run fully offline against a local Ollama instead
# (the Compose default points OLLAMA_BASE_URL at its service container):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# A generic OpenAI-compatible endpoint is also available via LLM_PROVIDER=openai_compatible.
# LLM_TIMEOUT_SECONDS=60

# Optional GitHub issue tools (disabled until configured and enabled by an admin).
# GITHUB_ENABLED=false
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=owner/repository

# Mail/contact tools intentionally remain unavailable until explicit consent is specified.
# INTERCOM_ENABLED=true
